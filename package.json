{
  "name": "elixer-focus",
  "private": true,
  "workspaces": [
    "web",
    "app",
    "packages/shared"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:web && npm run lint:app && npm run lint:shared",
    "lint:web": "cd web && npm run lint",
    "lint:app": "cd app && npm run lint",
    "lint:shared": "npm run lint --workspace=@elixer-focus/shared",
    "typecheck": "npm run typecheck:web && npm run typecheck:app && npm run typecheck:shared",
    "typecheck:web": "cd web && npx tsc -b --force --noEmit",
    "typecheck:app": "cd app && npx tsc --noEmit",
    "typecheck:shared": "npm run typecheck --workspace=@elixer-focus/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:shared && npm run test:web",
    "test:shared": "npm run test --workspace=@elixer-focus/shared",
    "test:web": "cd web && npm run test -- --run",
    "test:backend": "cd backend && composer test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
